@mode(host.dual)

# Unit tests for cp's command-line parsing (source/cli/args.loup): short
# clusters, the forms and errors of -t, options after operands, `--` and
# long options.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this file
# with Stage0 (`loup-bootstrap test`, source/ on LOUPPATH), one test per
# `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (parse_args, match_long);

func test_no_arguments(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.operands.len(), 0, "no operands");
    expect(!opts.recursive and !opts.no_clobber and !opts.force and !opts.verbose, "no flags");
    expect(!opts.no_target and !opts.has_target_dir, "no target options");
}

func test_combined_short_options(): void {
    let opts = parse_args(["-rnfvT", "a", "b"]).unwrap();
    expect(opts.recursive and opts.no_clobber and opts.force, "-r -n -f");
    expect(opts.verbose and opts.no_target, "-v -T");
    expect(parse_args(["-R"]).unwrap().recursive, "-R");
}

func test_target_directory_forms(): void {
    let separate = parse_args(["-t", "dir", "a"]).unwrap();
    expect(separate.has_target_dir, "-t DIR");
    expectEq(separate.target_dir, "dir", "separate argument");
    expectEq(separate.operands.len(), 1, "one source");
    expectEq(parse_args(["-tdir", "a"]).unwrap().target_dir, "dir", "attached");
    expectEq(parse_args(["-vtdir", "a"]).unwrap().target_dir, "dir", "after another letter");
    expectEq(parse_args(["--target-directory=dir", "a"]).unwrap().target_dir, "dir", "--target-directory=DIR");
    expectEq(parse_args(["--target", "dir", "a"]).unwrap().target_dir, "dir", "abbreviated, separate");
    let empty = parse_args(["-t", "", "a"]).unwrap();
    expect(empty.has_target_dir and empty.target_dir == "", "an empty directory name is still given");
}

func test_target_directory_errors(): void {
    expectEq(parse_args(["a", "-t"]).unwrap_err(), "option requires an argument -- 't'", "-t at the end");
    expectEq(parse_args(["--target-directory"]).unwrap_err(),
        "option '--target-directory' requires an argument", "long form");
    expectEq(parse_args(["-t", "x", "-t", "y"]).unwrap_err(), "multiple target directories specified", "twice");
}

func test_options_anywhere_and_double_dash(): void {
    let opts = parse_args(["a", "-v", "b"]).unwrap();
    expect(opts.verbose, "-v after an operand");
    expectEq(opts.operands.len(), 2, "two operands");
    let literal = parse_args(["--", "-v", "b"]).unwrap();
    expect(!literal.verbose, "-v after --");
    expectEq(literal.operands[0], "-v", "operand");
}

func test_long_options(): void {
    let opts = parse_args(["--recursive", "--no-clobber", "--force", "--verbose", "--no-target-directory"]).unwrap();
    expect(opts.recursive and opts.no_clobber and opts.force and opts.verbose and opts.no_target, "all long flags");
    expectEq(match_long("rec").unwrap(), "recursive", "prefix");
    expectEq(match_long("no").unwrap_err(),
        "option '--no' is ambiguous; possibilities: '--no-clobber' '--no-target-directory'", "ambiguous");
    expectEq(parse_args(["--verbose=1"]).unwrap_err(), "option '--verbose' doesn't allow an argument", "argument");
    expectEq(parse_args(["--bogus"]).unwrap_err(), "unrecognized option '--bogus'", "unknown");
    expectEq(parse_args(["-z"]).unwrap_err(), "invalid option -- 'z'", "-z");
}
