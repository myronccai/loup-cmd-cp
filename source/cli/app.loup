@mode(host.dual)

# The command-line driver of cp: parses argv, answers --help and --version,
# runs the copy and returns the exit status (1 for any failure, usage errors
# included, as in GNU cp).
#
# Runtime: host.dual. Compiled into the native binary build/cp by
# `make build`; `loup run source/main.loup` interprets the same code, and
# tests/app_test.loup calls run() directly under Stage0 (`make test`).

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE, EXIT_USAGE);
from cli.args import (parse_args);
from cli.usage import (usage, version_line);
from commands.cp import (run_cp);

# Whether a parse error is followed by the "Try 'cp --help'" line; GNU cp
# omits it after "multiple target directories specified".
pub func wants_try(msg: string): bool {
    return !msg.startsWith("multiple target directories");
}

# Parses argv, runs cp and returns the exit status.
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(msg) => {
            printErr(i"{$ APP_NAME $}: {$ msg $}");
            if (wants_try(msg)) {
                printErr(i"Try '{$ APP_NAME $} --help' for more information.");
            }
            return EXIT_USAGE;
        },
    };

    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }

    try {
        return run_cp(opts);
    } catch (Exception as e) {
        printErr(i"{$ APP_NAME $}: {$ e.message $}");
        return EXIT_FAILURE;
    }
}
