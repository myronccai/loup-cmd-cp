@mode(host.dual)

# Application identity. Keep APP_NAME and APP_VERSION in step with `name`
# and `version` in package.lppkg.

pub const APP_NAME: string = "cp";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Copy files and directories (a Loup recreation of GNU cp).";

# Exit statuses returned by main(). GNU cp uses 1 for every failure,
# usage errors included.
pub const EXIT_OK: int = 0;
pub const EXIT_FAILURE: int = 1;
pub const EXIT_USAGE: int = 1;
